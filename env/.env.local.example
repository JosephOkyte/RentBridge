# ====================================================================
# RENTBRIDGE NIGERIA - LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# Copy this file to .env.local in the root directory
# ====================================================================

# --------------------------------------------------------------------
# 1. CLERK AUTHENTICATION (User Management, Roles & MFA)
# Obtain from: https://dashboard.clerk.com/ -> API Keys & Webhooks
# --------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk Webhook Secret (from Clerk Dashboard -> Webhooks -> Add Endpoint -> Signing Secret)
# Used to verify events at: http://localhost:3000/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk Application URL Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --------------------------------------------------------------------
# 2. SUPABASE (PostgreSQL Database & Media Storage Buckets)
# Obtain from: https://supabase.com/dashboard -> Project Settings -> API
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SUPABASE_SERVICE_ROLE_KEY is STRICTLY private and never exposed to the browser.
# Used exclusively by Super Admin stealth audit desk, verification queue, and Clerk webhooks.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Storage Bucket Names
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_PHOTOS=property-showcase
SUPABASE_STORAGE_BUCKET_LEGAL=legal-vault

# --------------------------------------------------------------------
# 3. RESEND (Transactional Email Management & Fraud Alerts)
# Obtain from: https://resend.com/api-keys
# --------------------------------------------------------------------
RESEND_API_KEY=re_123456789...
EMAIL_FROM="RentBridge Nigeria <notifications@rentbridge.ng>"
ADMIN_ALERT_EMAIL="compliance@rentbridge.ng"

# --------------------------------------------------------------------
# 4. APPLICATION BASE URL
# --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

