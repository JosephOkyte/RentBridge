# ====================================================================
# RENTBRIDGE NIGERIA - ROOT ENVIRONMENT TEMPLATE
# For detailed guides, see the 'env/' folder:
# - env/.env.local.example (Local machine setup)
# - env/.env.development.example (Staging / preview setup)
# - env/.env.production.example (Production setup)
# - env/README.md (Step-by-step setup documentation)
# ====================================================================

# --------------------------------------------------------------------
# 1. Clerk Authentication (Users & Role Management)
# --------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --------------------------------------------------------------------
# 2. Supabase (Database & Storage Buckets)
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_PHOTOS=property-showcase
SUPABASE_STORAGE_BUCKET_LEGAL=legal-vault

# --------------------------------------------------------------------
# 3. Resend (Transactional Email Management & Extortion Alerts)
# --------------------------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM="RentBridge Nigeria <notifications@rentbridge.ng>"
ADMIN_ALERT_EMAIL="compliance@rentbridge.ng"

# --------------------------------------------------------------------
# 4. App Base URL
# --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------------
# 5. WhatsApp Gateway (Termii or Meta Cloud API - Optional fallback to wa.me links)
# --------------------------------------------------------------------
# Option A: Termii (Nigerian SMS & WhatsApp Gateway)
TERMII_API_KEY=
TERMII_SENDER_ID=RentBridge

# Option B: Meta WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Admin Hotline WhatsApp number for instant extortion notifications
ADMIN_WHATSAPP_PHONE=2348000000000
